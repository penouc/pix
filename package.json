{
  "name": "pi-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local desktop coding agent powered by Pi Agent SDK",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pi-desktop/desktop dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @pi-desktop/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "node --test fixtures/test-repositories/react-button-label/test/button.test.js",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:runtime": "pnpm -r --filter './packages/*' build && PI_DESKTOP_FAKE_RUNTIME=1 SMOKE_PROMPT=1 node scripts/smoke-pi-runtime.mjs",
    "smoke:runtime:pi": "pnpm -r --filter './packages/*' build && PI_DESKTOP_FAKE_RUNTIME=0 node scripts/smoke-pi-runtime.mjs",
    "eval:fixture": "pnpm -r --filter './packages/*' build && node scripts/eval-fixture-button-label.mjs",
    "package:dir": "pnpm build && pnpm --filter @pi-desktop/desktop package:dir",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
