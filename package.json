{
  "name": "pi-desktop",
  "private": true,
  "version": "0.6.5",
  "type": "module",
  "description": "Local desktop coding agent powered by Pi Agent SDK",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pi-desktop/desktop dev",
    "dev:website": "pnpm --filter @pi-desktop/website dev",
    "build:website": "pnpm --filter @pi-desktop/website build",
    "deploy:website": "pnpm --filter @pi-desktop/website run deploy",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @pi-desktop/desktop build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm run build:packages && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "node --test fixtures/test-repositories/react-button-label/test/button.test.js",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "smoke:packaged:win": "node scripts/smoke-packaged.mjs --platform win32",
    "verify:packaged:win": "node scripts/verify-packaged.mjs --platform win32",
    "icon:generate": "./apps/desktop/node_modules/.bin/electron scripts/generate-app-icon.mjs",
    "smoke:runtime": "pnpm -r --filter \"./packages/*\" build && PI_DESKTOP_FAKE_RUNTIME=1 SMOKE_PROMPT=1 node scripts/smoke-pi-runtime.mjs",
    "smoke:runtime:pi": "pnpm -r --filter \"./packages/*\" build && PI_DESKTOP_FAKE_RUNTIME=0 node scripts/smoke-pi-runtime.mjs",
    "test:e2e": "pnpm build && playwright test",
    "eval:fixture": "pnpm -r --filter \"./packages/*\" build && node scripts/eval-fixture-button-label.mjs",
    "package:dir": "pnpm build && pnpm --filter @pi-desktop/desktop package:dir",
    "package:win:dir": "pnpm build && pnpm --filter @pi-desktop/desktop package:win:dir",
    "package:win": "pnpm build && pnpm --filter @pi-desktop/desktop package:win",
    "rebuild:native": "pnpm --filter @pi-desktop/desktop rebuild:native",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
