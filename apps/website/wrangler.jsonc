{
  "name": "pix",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "pix.penglei.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
